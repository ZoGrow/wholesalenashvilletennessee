{
  "daily_clean_leads": 100,
  "scrape_multiplier": 1,
  "apify": {
    "actor_id": "automation-lab~realtor-agents-scraper",
    "mode": "run",
    "input": {
      "locations": [
        "Nashville, TN"
      ],
      "listingStatus": "both"
    },
    "max_wait_minutes": 60
  },
  "field_map": {
    "first_name": [],
    "last_name": [],
    "full_name": [
      "name"
    ],
    "phone": [],
    "email": [
      "email"
    ],
    "company": [
      "brokerage"
    ],
    "website": [
      "websiteUrl"
    ],
    "address": [
      "officeAddress"
    ],
    "city": [
      "city"
    ],
    "state": [
      "state"
    ],
    "postal_code": [
      "postalCode"
    ],
    "source_url": [
      "profileUrl"
    ]
  },
  "ghl": {
    "tags": [
      "apify-daily-lead"
    ],
    "source": "Apify realtor agents scraper",
    "fail_on_errors": true,
    "dnd_tag": "dnd-skipped",
    "dnd_check_delay_seconds": 60
  },
  "output_dir": "output",
  "mobile_only": {
    "list_path": "phones",
    "types": [
      "mobile",
      "cell",
      "cellular",
      "wireless"
    ]
  },
  "suppression_file": "suppression.csv"
}
